# Gemini API Configuration
# Replace with your own keys — do NOT commit real secrets into the repository
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# Supported models (gemini-pro is deprecated and no longer served):
# gemini-3.6-flash | gemini-2.5-flash | gemini-2.0-flash | gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: Search API (if using separate search provider)
# SERPAPI_KEY=your_serpapi_key_here

# Wake word phrase to activate the assistant hands-free (default: "hey sobot")
# WAKE_PHRASE=hey sobot
