# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# Optional: Search API (if using separate search provider)
# SERPAPI_KEY=your_serpapi_key_here

# ==========================================
# Text-to-Speech (natural human voices)
# ==========================================
# Engine: edge-tts (Microsoft neural voices, no API key needed)
TTS_ENGINE=edge-tts
# Microsoft neural voice to use. Choose a natural female/male voice:
#   en-US-JennyNeural   (female, natural US)
#   en-US-AriaNeural    (female, expressive)
#   en-US-GuyNeural     (male, natural US)
#   en-GB-SoniaNeural   (female, UK)
#   en-GB-RyanNeural    (male, UK)
#   en-AU-NatashaNeural (female, AU)
TTS_VOICE=en-US-JennyNeural
# Voice rate modifier: +0%, -20%, +30%, etc.
TTS_RATE=+0%
# Voice volume modifier: +0%, -50%, +100%, etc.
TTS_VOLUME=+0%

# ==========================================
# Desktop Control (full computer access)
# ==========================================
# Enable OS-level desktop actions (screenshots, media keys, app launch, lock)
DESKTOP_CONTROL_ENABLED=true

# ==========================================
# Voice Recognition
# ==========================================
# Language for speech recognition
VOICE_LANGUAGE=en-US
# Enable continuous background listening on server (uses local mic)
VOICE_BACKGROUND_ENABLED=false
VOICE_TIMEOUT=5
VOICE_PHRASE_LIMIT=10

# ==========================================
# Hand Tracking & Gesture
# ==========================================
HAND_DETECTION_CONFIDENCE=0.7
HAND_TRACKING_CONFIDENCE=0.5
CURSOR_SMOOTHING=0.45
CLICK_DISTANCE_THRESHOLD=0.055
SCROLL_THRESHOLD=0.08
# Whether cursor control starts enabled
CURSOR_CONTROL_ENABLED=false

# ==========================================
# System Control
# ==========================================
VOLUME_STEP=5
BRIGHTNESS_STEP=5

# ==========================================
# Web Server
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
